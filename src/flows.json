    {
        "id": "57ae78f0df8be98a",
        "type": "function",
        "z": "0ecdcae38ddc3783",
        "name": "Merge Data",
        "func": "let brightness = flow.get(\"brightness\");\nlet dhpstate = flow.get(\"dhpState\");\nlet miststate = flow.get(\"mistState\");\nlet lastaction = flow.get(\"lastAction\");\n\nif (brightness != undefined && dhpstate != undefined && miststate != undefined) {\n    msg.payload = {\n        studentid: 0,\n        nickname: \"ENCLOSURE STATUS\",\n        //temp: temperature,\n        //hum: humidity,\n        rain: brightness,\n        windspeed: dhpstate ? 1 : 0,\n        winddir: miststate ? 1 : 0,\n        message: lastaction,\n        valid: true,\n    }\n    return msg;\n} else {\n    return null;\n}",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 290,
        "y": 1480,
