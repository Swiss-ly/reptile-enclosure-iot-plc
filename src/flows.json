    {
        "id": "70f77b536e5d15a2",
        "type": "function",
        "z": "0ecdcae38ddc3783",
        "name": "Duty Cycle",
        "func": "var msg1 = {payload: msg.payload.toString()};\n\nlet val = msg.payload\nlet dutyCycle= (1-(val-454)/(990-454))*100; //Scales ADC value between 0-100 for PWM duty cycle.\nif (dutyCycle < 10) {\n    dutyCycle = 0; // Fully Off\n} else if (dutyCycle > 90) {\n    dutyCycle = 100; // Fully On\n}\n\nlet plcValue = Math.round(dutyCycle);\n\nplcValue = { payload: plcValue};\nreturn [msg1, plcValue];",
        "outputs": 2,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
