        "type": "function",
        "z": "0ecdcae38ddc3783",
        "name": "Mister Last Action Check",
        "func": "let lastMistState = flow.get(\"mistState\") || 0;\n\nlet currentMistState = msg.payload;\n\nif (currentMistState != lastMistState) {\n    if (currentMistState == 1) {\n        flow.set(\"lastAction\", \"Mister Switched ON\");\n    } else {\n        flow.set(\"lastAction\", \"Mister Switched OFF\");\n    }\n    flow.set(\"mistState\", currentMistState);\n}\nreturn null;",
        "outputs": 2,
        "noerr": 0,
